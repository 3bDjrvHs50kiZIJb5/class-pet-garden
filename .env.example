# MySQL（docker compose 使用）
MYSQL_ROOT_PASSWORD=classpets
MYSQL_DATABASE=classpets

# 应用数据库连接
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=classpets
DB_NAME=classpets
DB_CONNECTION_LIMIT=10

# 应用端口
APP_PORT=3002
PORT=3002

# 认证限流（同一 IP）
AUTH_RATE_LIMIT_ENABLED=true
AUTH_REGISTER_RATE_LIMIT_MAX=1
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000

# 安全（生产环境务必修改）
TOKEN_SECRET=请替换为随机长字符串
CAPTCHA_SECRET=请替换为随机长字符串（可与 TOKEN_SECRET 同源派生）
ADMIN_DEFAULT_PASSWORD=请替换为强密码

# Cloudflare Turnstile（注册页人机验证）
# 站点密钥可写入仓库；私密密钥仅放在服务端环境变量，切勿提交
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAGAdkKqvKPPUtyGY
TURNSTILE_SECRET=从 Cloudflare Turnstile 控制台复制 Secret Key
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,bot123.cc
# 本地无密钥时可使用 Cloudflare 测试密钥：site=1x00000000000000000000AA secret=1x0000000000000000000000000000000AA
